  "productName": "Retail Sathi",
  "version": "0.1.1",
  "identifier": "com.tarekul.retail-sathi",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Retail Sathi",
        "width": 1280,
        "height": 800,
        "maximized": true
